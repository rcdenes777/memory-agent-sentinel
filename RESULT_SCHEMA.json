{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Memory Sentinel V1 Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "timestamp",
    "benchmark_version",
    "candidate",
    "environment",
    "provenance",
    "gates",
    "metrics",
    "session_logs"
  ],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "benchmark_version": { "type": "string", "const": "1.0.0" },
    "candidate": { "type": "string", "enum": ["no-memory", "ai-memory", "other"] },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_version", "platform", "agent_model"],
      "properties": {
        "node_version": { "type": "string" },
        "typescript_version": { "type": "string" },
        "platform": { "type": "string" },
        "agent_model": { "type": "string" },
        "memory_system_version": { "type": ["string", "null"] }
      }
    },
    "provenance": {
      "type": "object",
      "description": "Binds this result to the exact code and inputs that produced it, so a result cannot be replayed or edited and still claim to represent a real run.",
      "additionalProperties": false,
      "required": ["benchmark_commit_sha", "fixture_sha256"],
      "properties": {
        "benchmark_commit_sha": { "type": "string", "minLength": 7 },
        "fixture_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 over the concatenation of every file under fixtures/ used by this run, in sorted path order."
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "S0_BASELINE_NO_MEMORY",
        "S1_SESSION_CAPTURE",
        "S2_CROSS_SESSION_RECALL",
        "S3_STALE_SUPERSESSION",
        "S4_MULTI_HOP_RECALL",
        "S5_PROVENANCE_BINDING",
        "S6_PROJECT_ISOLATION",
        "S7_RESTART_PERSISTENCE",
        "S8_CONTEXT_DEPENDENT_CODING_TASK"
      ],
      "properties": {
        "S0_BASELINE_NO_MEMORY": { "$ref": "#/definitions/gate_result" },
        "S1_SESSION_CAPTURE": { "$ref": "#/definitions/gate_result" },
        "S2_CROSS_SESSION_RECALL": { "$ref": "#/definitions/gate_result" },
        "S3_STALE_SUPERSESSION": { "$ref": "#/definitions/gate_result" },
        "S4_MULTI_HOP_RECALL": { "$ref": "#/definitions/gate_result" },
        "S5_PROVENANCE_BINDING": { "$ref": "#/definitions/gate_result" },
        "S6_PROJECT_ISOLATION": { "$ref": "#/definitions/gate_result" },
        "S7_RESTART_PERSISTENCE": { "$ref": "#/definitions/gate_result" },
        "S8_CONTEXT_DEPENDENT_CODING_TASK": { "$ref": "#/definitions/gate_result" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["FILES_READ", "GREP_CALLS", "MANUAL_INTERVENTIONS", "TOTAL_DURATION_SECONDS", "TOKEN_TELEMETRY"],
      "properties": {
        "FILES_READ": { "type": "integer", "minimum": 0 },
        "GREP_CALLS": { "type": "integer", "minimum": 0 },
        "MANUAL_INTERVENTIONS": { "type": "integer", "minimum": 0, "const": 0 },
        "TOTAL_DURATION_SECONDS": { "$ref": "#/definitions/maybe_number" },
        "TOKEN_TELEMETRY": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_tokens",
            "output_tokens",
            "cache_read_input_tokens",
            "cache_creation_input_tokens",
            "total_cost_usd",
            "num_turns",
            "duration_ms",
            "duration_api_ms"
          ],
          "properties": {
            "input_tokens": { "$ref": "#/definitions/maybe_number" },
            "output_tokens": { "$ref": "#/definitions/maybe_number" },
            "cache_read_input_tokens": { "$ref": "#/definitions/maybe_number" },
            "cache_creation_input_tokens": { "$ref": "#/definitions/maybe_number" },
            "total_cost_usd": { "$ref": "#/definitions/maybe_number" },
            "num_turns": { "$ref": "#/definitions/maybe_number" },
            "duration_ms": { "$ref": "#/definitions/maybe_number" },
            "duration_api_ms": { "$ref": "#/definitions/maybe_number" }
          }
        }
      }
    },
    "session_logs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["session_label", "session_id", "is_error", "started_at", "ended_at", "memory_leak_suspected"],
        "properties": {
          "session_label": { "type": "string" },
          "session_id": { "type": "string" },
          "is_error": { "type": "boolean" },
          "started_at": { "type": "string", "format": "date-time" },
          "ended_at": { "type": "string", "format": "date-time" },
          "memory_leak_suspected": {
            "type": "boolean",
            "description": "True when a lifecycle hook returned more than a trivial acknowledgement for this session, suggesting a memory/context system may have injected content even for a no-memory run."
          }
        }
      }
    },
    "notes": { "type": "string" }
  },
  "definitions": {
    "maybe_number": {
      "description": "Either an exact measured number, or the literal string UNAVAILABLE. Never silently 0.",
      "oneOf": [{ "type": "number" }, { "type": "string", "const": "UNAVAILABLE" }]
    },
    "gate_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "details", "measurements"],
      "properties": {
        "status": { "enum": ["PASS", "FAIL", "INCOMPLETE"] },
        "details": { "type": "string", "minLength": 1 },
        "measurements": { "type": "object" }
      }
    }
  }
}
