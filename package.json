{
  "name": "memory-sentinel-benchmark",
  "version": "1.0.0",
  "description": "Vendor-neutral benchmark for persistent memory/context systems",
  "main": "dist/runner/runner.js",
  "scripts": {
    "build": "tsc",
    "baseline:no-memory": "node dist/runner/runner.js --candidate no-memory",
    "baseline:ai-memory": "node dist/runner/runner.js --candidate ai-memory",
    "baseline:all": "npm run baseline:no-memory && npm run baseline:ai-memory",
    "baseline:test": "node dist/runner/runner.js",
    "setup:fixtures": "node dist/runner/setup-fixtures.js",
    "view-results": "node dist/runner/view-results.js",
    "compare-results": "node dist/runner/compare-results.js",
    "report:baseline": "node dist/runner/report-baseline.js",
    "test": "jest",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/jest": "29.5.2",
    "@types/node": "20.3.1",
    "jest": "29.5.0",
    "ts-jest": "29.1.0",
    "ts-node": "10.9.1",
    "typescript": "5.1.3"
  },
  "dependencies": {},
  "keywords": [
    "benchmark",
    "memory",
    "context",
    "autonomous-agents",
    "testing"
  ],
  "author": "",
  "license": "MIT"
}
